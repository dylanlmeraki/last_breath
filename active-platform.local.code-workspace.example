{
	"folders": [
		{
			"path": ".",
			"name": "repo-root (config only)"
		}
	],
	"settings": {
		"liveServer.settings.multiRootWorkspaceName": "repo-root (config only)"
	},
	"mcp": {
		"servers": {
			"io.github.microsoft/awesome-copilot": {
				"type": "stdio",
				"command": "docker",
				"args": [
					"run",
					"-i",
					"--rm",
					"ghcr.io/microsoft/mcp-dotnet-samples/awesome-copilot:1.0.2026040123"
				],
				"gallery": "https://api.mcp.github.com",
				"version": "1.0.2026040123"
			}
		}
	}
}
