marketing.css - i'm giving you part of my enhanced marketing.css, not all. I want you to integrate what im giving you this updated color pallet into what you have, then you can reproduce me a drop in full marketing.css file. :

.marketing-portal {
  /* Brand core */
  --pe-navy: #161D30;
  --pe-blue: #2253DA;
  --pe-blue-light: #387CF3;
  --pe-blue-bright: #2F8BFF;

  --pe-cyan: #0DA7E7;
  --pe-cyan-teal: #0CB7D6;
  --pe-teal: #13C5A5;

  /* Warm accents */
  --pe-orange: #F5751F;
  --pe-orange-bright: #FF9A3D;
  --pe-amber: #FFD08A;

  /* Surfaces */
  --pe-surface: #FFFFFF;
  --pe-surface-2: #F7FAFC;
  --pe-surface-3: #EEF3F8;

  /* Text */
  --pe-text: #0F172A;
  --pe-text-soft: #334155;
  --pe-text-muted: #64748B;

  /* Borders */
  --pe-border: rgba(22, 29, 48, 0.10);
  --pe-border-strong: rgba(22, 29, 48, 0.16);
  --pe-border-dark: rgba(255, 255, 255, 0.12);

  /* Shadows */
  --pe-shadow-sm: 0 6px 18px rgba(15, 23, 42, 0.08);
  --pe-shadow-md: 0 18px 44px rgba(15, 23, 42, 0.12);
  --pe-shadow-lg: 0 28px 70px rgba(15, 23, 42, 0.18);

  color: var(--pe-text);
  background: var(--pe-surface);
  text-rendering: optimizeLegibility;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

.marketing-portal,
.marketing-portal * {
  box-sizing: border-box;
}

/* Sticky header anchor offset */
.marketing-portal section[id] {
  scroll-margin-top: 96px;
}

/* Focus */
.marketing-portal :focus-visible {
  outline: 2px solid var(--pe-cyan);
  outline-offset: 2px;
}

/* Selection */
.marketing-portal ::selection {
  background: rgba(13, 167, 231, 0.18);
  color: var(--pe-text);
}

/* Media defaults */
.marketing-portal img,
.marketing-portal video {
  display: block;
  max-width: 100%;
}

/* Quiet technical grid helpers */
.marketing-portal .blueprint-grid {
  background-image:
    linear-gradient(rgba(13, 167, 231, 0.035) 1px, transparent 1px),
    linear-gradient(90deg, rgba(13, 167, 231, 0.035) 1px, transparent 1px);
  background-size: 48px 48px;
}

.marketing-portal .blueprint-grid-fine {
  background-image:
    linear-gradient(rgba(13, 167, 231, 0.018) 1px, transparent 1px),
    linear-gradient(90deg, rgba(13, 167, 231, 0.018) 1px, transparent 1px);
  background-size: 12px 12px;
}

.marketing-portal .gradient-text-cool {
  background: linear-gradient(
    135deg,
    var(--pe-blue),
    var(--pe-cyan),
    var(--pe-blue-light)
  );
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.marketing-portal .section-surface {
  background: linear-gradient(180deg, var(--pe-surface-2) 0%, var(--pe-surface) 100%);
}

.marketing-portal .section-surface-soft {
  background: var(--pe-surface-2);
}

.marketing-portal .section-surface-solid {
  background: var(--pe-surface);
}

/* Card helpers */
.marketing-portal .pe-card {
  background: var(--pe-surface);
  border: 1px solid var(--pe-border);
  border-radius: 24px;
  box-shadow: var(--pe-shadow-sm);
  transition:
    transform 180ms cubic-bezier(0.22, 1, 0.36, 1),
    box-shadow 180ms cubic-bezier(0.22, 1, 0.36, 1),
    border-color 180ms cubic-bezier(0.22, 1, 0.36, 1);
}

