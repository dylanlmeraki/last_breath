id)}</span><br><span>              </span><span class="ͼu">onFocus</span><span class="ͼn">=</span><span>{() =&gt; </span><span class="ͼt">onActivate</span><span>(</span><span class="ͼt">marker</span><span class="ͼn">.</span><span>id)}</span><br><span>              </span><span class="ͼu">className</span><span class="ͼn">=</span><span>{</span><span class="ͼr">`project-map-marker </span><span>${</span><span class="ͼt">toneClass</span><span>}</span><span class="ͼr"> </span><span>${</span><span class="ͼt">activeMarkerId</span><span> </span><span class="ͼn">===</span><span> </span><span class="ͼt">marker</span><span class="ͼn">.</span><span>id </span><span class="ͼn">?</span><span> </span><span class="ͼr">"active animate-pulse-cyan"</span><span> </span><span class="ͼn">:</span><span> </span><span class="ͼr">""</span><span>}</span><span class="ͼr">`</span><span>}</span><br><span>              </span><span class="ͼu">style</span><span class="ͼn">=</span><span>{{ left: </span><span class="ͼt">pos</span><span class="ͼn">.</span><span>left, top: </span><span class="ͼt">pos</span><span class="ͼn">.</span><span>top }}</span><br><span>            </span><span class="ͼv">/&gt;</span><br><span>          );</span><br><span>        })}</span><br><br><span>        </span><span class="ͼv">&lt;div</span><span> </span><span class="ͼu">className</span><span class="ͼn">=</span><span class="ͼr">"project-map-legend"</span><span class="ͼv">&gt;</span><br><span>          </span><span class="ͼv">&lt;div</span><span> </span><span class="ͼu">className</span><span class="ͼn">=</span><span class="ͼr">"project-map-legend-items"</span><span class="ͼv">&gt;</span><br><span>            </span><span class="ͼv">&lt;span</span><span> </span><span class="ͼu">className</span><span class="ͼn">=</span><span class="ͼr">"project-map-legend-item status-active"</span><span class="ͼv">&gt;</span><span>Featured</span><span class="ͼv">&lt;/span&gt;</span><br><span>            </span><span class="ͼv">&lt;span</span>